    "directory": "."
  },
  "bugs": {
    "url": "https://github.com/YYC-Cube/YYC3-Infinite-Gallery/issues"
  },
  "author": {
    "name": "YYC³",
    "email": "contact@yyc3.top",
    "url": "https://yyc3.top"
  },
  "license": "MIT",
  "scripts": {
    "dev": "next dev --turbopack -p 3033",
    "dev:lan": "next dev --turbopack --hostname 0.0.0.0 -p 3033",
    "build": "next build --turbopack",
    "postbuild": "node scripts/generate-sw-assets.mjs",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch --passWithNoTests",
    "test:coverage": "jest --coverage --passWithNoTests",
    "docs:check": "node scripts/check-docs.mjs",
    "security:check": "node scripts/check-security.mjs",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,css}\"",
    "analyze": "ANALYZE=true next build",
    "benchmark": "node scripts/benchmark.mjs",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "audit": "pnpm audit",
    "update-deps": "pnpm update --latest --interactive"
  },
